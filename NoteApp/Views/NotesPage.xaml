<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="NoteApp.Views.NotesPage"
             x:DataType="viewModels:NotesViewModel"
             xmlns:viewModels="clr-namespace:NoteApp.ViewModels"
             xmlns:models="clr-namespace:NoteApp.Models"
             xmlns:sys="clr-namespace:System;assembly=netstandard"
             Title=""
             BackgroundColor="{StaticResource WindowsBeige}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 
             |                     |
             |   Header Section    |
             |                     |
              -->
        <Border Grid.Row="0" 
                StrokeThickness="2"
                Stroke="{StaticResource ButtonShadow}"
                BackgroundColor="{StaticResource ButtonFace}">
            <Grid Padding="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                
                <!-- 
                     |                     |
                     |  Title & Search     |
                     |                     |
                      -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    
                    <Label Grid.Column="0"
                           Text="Quicknote v4.1.1"
                           FontAttributes="Bold"
                           FontSize="16"
                           VerticalOptions="Center"
                           Margin="4,0,12,0"
                           FontFamily="MS Sans Serif" />
                    
                    <Border Grid.Column="1"
                            StrokeThickness="2"
                            BackgroundColor="{StaticResource SearchBackground}">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="0" />
                        </Border.StrokeShape>
                        <Border.Stroke>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="{StaticResource Gray700}" Offset="0.0" />
                                <GradientStop Color="{StaticResource Gray300}" Offset="0.5" />
                                <GradientStop Color="{StaticResource White}" Offset="1.0" />
                            </LinearGradientBrush>
                        </Border.Stroke>
                        <Entry Placeholder="Type here to search..."
                               Text="{Binding SearchText}"
                               BackgroundColor="Transparent"
                               FontFamily="MS Sans Serif"
                               FontSize="11"
                               Margin="4,2"
                               ClearButtonVisibility="WhileEditing" />
                    </Border>
                    
                    <HorizontalStackLayout Grid.Column="2" Spacing="4" Margin="4,0,0,0">
                        <Button Text="Search"
                                Command="{Binding SearchCommand}"
                                WidthRequest="60"
                                HeightRequest="24"
                                FontFamily="MS Sans Serif"
                                FontSize="10"
                                Padding="2" />
                        <Button Text="Clear"
                                Command="{Binding ClearSearchCommand}"
                                IsVisible="{Binding SearchText, Converter={StaticResource StringIsNotNullOrEmptyConverter}}"
                                WidthRequest="50"
                                HeightRequest="24"
                                FontFamily="MS Sans Serif"
                                FontSize="10"
                                Padding="2" />
                    </HorizontalStackLayout>
                </Grid>
                
                <!-- 
                     |                     |
                     |  Filter Controls    |
                     |                     |
                      -->
                <Grid Grid.Row="1" Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    
                    <Label Grid.Column="0" 
                           Text="Category:" 
                           VerticalOptions="Center"
                           Margin="4,0,8,0"
                           FontFamily="MS Sans Serif"
                           FontSize="11" />
                    
                    <Border Grid.Column="1"
                            StrokeThickness="2"
                            BackgroundColor="{StaticResource PaperWhite}"
                            Margin="0,0,8,0">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="0" />
                        </Border.StrokeShape>
                        <Border.Stroke>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="{StaticResource Gray700}" Offset="0.0" />
                                <GradientStop Color="{StaticResource Gray300}" Offset="0.5" />
                                <GradientStop Color="{StaticResource White}" Offset="1.0" />
                            </LinearGradientBrush>
                        </Border.Stroke>
                        <Picker Title="All Categories"
                                ItemsSource="{Binding Categories}"
                                SelectedItem="{Binding SelectedCategory}"
                                BackgroundColor="Transparent"
                                FontFamily="MS Sans Serif"
                                FontSize="11"
                                Margin="2,0" />
                    </Border>
                    
                    <Label Grid.Column="2" 
                           Text="Sort:" 
                           VerticalOptions="Center"
                           Margin="0,0,4,0"
                           FontFamily="MS Sans Serif"
                           FontSize="11" />
                    
                    <Picker Grid.Column="3"
                            SelectedItem="{Binding SortBy}"
                            BackgroundColor="{StaticResource PaperWhite}"
                            FontFamily="MS Sans Serif"
                            FontSize="11"
                            WidthRequest="100">
                        <Picker.ItemsSource>
                            <x:Array Type="{x:Type x:String}">
                                <x:String>DateModified</x:String>
                                <x:String>Title</x:String>
                                <x:String>Category</x:String>
                                <x:String>DateCreated</x:String>
                            </x:Array>
                        </Picker.ItemsSource>
                    </Picker>
                    
                    <Button Grid.Column="4"
                            Text="{Binding SortAscending, Converter={StaticResource BoolToSortIconConverter}, ConverterParameter='↓↑'}"
                            Command="{Binding ToggleSortOrderCommand}"
                            WidthRequest="24"
                            HeightRequest="24"
                            FontFamily="MS Sans Serif"
                            FontSize="12"
                            Padding="0"
                            Margin="2,0,0,0" />
                </Grid>
                
                <!-- 
                     |                     |
                     |   Status Display    |
                     |                     |
                      -->
                <Border Grid.Row="2"
                        StrokeThickness="1"
                        Stroke="{StaticResource Gray400}"
                        BackgroundColor="{StaticResource Gray100}"
                        Margin="0,4,0,0"
                        Padding="4,2">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        
                        <HorizontalStackLayout Grid.Column="0" Spacing="12">
                            <Label Text="{Binding FilteredNotes.Count, StringFormat='📄 {0} notes'}"
                                   FontFamily="MS Sans Serif"
                                   FontSize="10"
                                   VerticalOptions="Center" />
                            <Label Text="{Binding Notes.Count, StringFormat='(showing {0})'}"
                                   FontFamily="MS Sans Serif"
                                   FontSize="10"
                                   VerticalOptions="Center"
                                   IsVisible="{Binding HasMoreItems}" />
                            <Label Text=""
                                   FontFamily="MS Sans Serif"
                                   FontSize="9"
                                   TextColor="Green"
                                   VerticalOptions="Center" />
                        </HorizontalStackLayout>
                        
                        <Label Grid.Column="1"
                               Text="Fhox Edition"
                               FontFamily="MS Sans Serif"
                               FontSize="9"
                               FontAttributes="Italic"
                               TextColor="{StaticResource Gray600}"
                               VerticalOptions="Center" />
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- 
             |                     |
             |    Notes List       |
             |                     |
              -->
        <Border Grid.Row="1" 
                StrokeThickness="2"
                BackgroundColor="{StaticResource ContentWhite}"
                Margin="0,2">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="0" />
            </Border.StrokeShape>
            <Border.Stroke>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="{StaticResource Gray700}" Offset="0.0" />
                    <GradientStop Color="{StaticResource Gray300}" Offset="0.5" />
                    <GradientStop Color="{StaticResource White}" Offset="1.0" />
                </LinearGradientBrush>
            </Border.Stroke>
            
            <RefreshView IsRefreshing="{Binding IsRefreshing}"
                         Command="{Binding RefreshCommand}">
                <CollectionView ItemsSource="{Binding Notes}"
                                SelectionMode="None"
                                RemainingItemsThreshold="5"
                                RemainingItemsThresholdReachedCommand="{Binding LoadMoreCommand}"
                                BackgroundColor="Transparent"
                                VerticalScrollBarVisibility="Always">
                    
                    <!-- 
                         |                     |
                         |   Empty State       |
                         |                     |
                          -->
                    <CollectionView.EmptyView>
                        <Border StrokeThickness="3"
                                Stroke="{StaticResource Gray500}"
                                BackgroundColor="{StaticResource PaperWhite}"
                                Margin="40"
                                Padding="30">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="0" />
                            </Border.StrokeShape>
                            <VerticalStackLayout VerticalOptions="Center" 
                                               HorizontalOptions="Center" 
                                               Spacing="12">
                                <Label Text="📂" 
                                       FontSize="48" 
                                       HorizontalTextAlignment="Center" />
                                <Label Text="No documents found" 
                                       FontSize="14" 
                                       FontAttributes="Bold"
                                       HorizontalTextAlignment="Center"
                                       FontFamily="MS Sans Serif" />
                                <Label Text="Click 'New' to create a note" 
                                       HorizontalTextAlignment="Center"
                                       FontFamily="MS Sans Serif"
                                       FontSize="11" />
                               
                               <Button Text="➕ Create New Note"
                                        Command="{Binding AddNoteCommand}"
                                        HorizontalOptions="Center"
                                        FontFamily="MS Sans Serif"
                                        FontSize="11"
                                        BackgroundColor="{StaticResource AccentBlue}"
                                        TextColor="White"
                                        Padding="12,6"
                                        MinimumWidthRequest="140" />
                            </VerticalStackLayout>
                        </Border>
                    </CollectionView.EmptyView>
                    
                    <!-- 
                         |                     |
                         |   Note Items        |
                         |                     |
                          -->
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:Note">
                            <Border StrokeThickness="2"
                                    BackgroundColor="{StaticResource PaperWhite}"
                                    Margin="4,2"
                                    Padding="0">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="0" />
                                </Border.StrokeShape>
                                <Border.Stroke>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="{StaticResource White}" Offset="0.0" />
                                        <GradientStop Color="{StaticResource Gray300}" Offset="0.5" />
                                        <GradientStop Color="{StaticResource Gray700}" Offset="1.0" />
                                    </LinearGradientBrush>
                                </Border.Stroke>
                                
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    
                                    <!-- 
                                         |                     |
                                         |    Note Icon        |
                                         |                     |
                                          -->
                                    <Border Grid.Column="0"
                                            BackgroundColor="{StaticResource Gray200}"
                                            WidthRequest="40"
                                            StrokeThickness="0"
                                            Margin="0,0,1,0">
                                        <Label Text="📄"
                                               FontSize="20"
                                               HorizontalOptions="Center"
                                               VerticalOptions="Center" />
                                    </Border>
                                    
                                    <!-- 
                                         |                     |
                                         |   Note Content      |
                                         |                     |
                                          -->
                                    <Grid Grid.Column="1" Padding="8,6">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        
                                        <Label Grid.Row="0"
                                               Text="{Binding Title}"
                                               FontSize="12"
                                               FontAttributes="Bold"
                                               TextColor="{StaticResource Black}"
                                               FontFamily="MS Sans Serif"
                                               LineBreakMode="TailTruncation"
                                               MaxLines="1" />
                                        
                                        <Label Grid.Row="1"
                                               Text="{Binding ContentPreview}"
                                               MaxLines="2"
                                               LineBreakMode="TailTruncation"
                                               TextColor="{StaticResource Gray700}"
                                               FontSize="10"
                                               Margin="0,2"
                                               FontFamily="MS Sans Serif" />
                                        
                                        <HorizontalStackLayout Grid.Row="2" Spacing="8" Margin="0,2,0,0">
                                            <Border BackgroundColor="{StaticResource CategoryBackground}"
                                                    StrokeThickness="1"
                                                    Stroke="{StaticResource Gray500}"
                                                    Padding="4,1">
                                                <Label Text="{Binding Category}"
                                                       FontSize="9"
                                                       FontFamily="MS Sans Serif" />
                                            </Border>
                                            
                                            <Label Text="{Binding TimeAgo}"
                                                   FontSize="9"
                                                   TextColor="{StaticResource Gray600}"
                                                   FontFamily="MS Sans Serif"
                                                   VerticalOptions="Center" />
                                        </HorizontalStackLayout>
                                    </Grid>
                                    
                                    <!-- 
                                         |                     |
                                         |  Action Buttons     |
                                         |                     |
                                          -->
                                    <VerticalStackLayout Grid.Column="2" 
                                                       Spacing="2"
                                                       VerticalOptions="Center"
                                                       Margin="4">
                                        <Button Text="Open"
                                                FontSize="9"
                                                WidthRequest="48"
                                                HeightRequest="22"
                                                Padding="0"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type viewModels:NotesViewModel}}, Path=SelectNoteCommand}"
                                                CommandParameter="{Binding .}"
                                                FontFamily="MS Sans Serif" />
                                        
                                        <Button Text="Delete"
                                                FontSize="9"
                                                WidthRequest="48"
                                                HeightRequest="22"
                                                Padding="0"
                                                BackgroundColor="{StaticResource Gray300}"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type viewModels:NotesViewModel}}, Path=DeleteNoteCommand}"
                                                CommandParameter="{Binding .}"
                                                FontFamily="MS Sans Serif" />
                                    </VerticalStackLayout>

                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer 
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type viewModels:NotesViewModel}}, Path=SelectNoteCommand}"
                                            CommandParameter="{Binding .}"
                                            NumberOfTapsRequired="2" />
                                    </Grid.GestureRecognizers>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                    
                    <!-- 
                         |                     |
                         |    Loading More     |
                         |                     |
                          -->
                    <CollectionView.Footer>
                        <StackLayout IsVisible="{Binding IsLoadingMore}" Padding="10">
                            <ActivityIndicator IsRunning="True" Color="{StaticResource AccentBlue}" />
                            <Label Text="Loading more notes..." 
                                   HorizontalOptions="Center"
                                   FontFamily="MS Sans Serif"
                                   FontSize="10" />
                        </StackLayout>
                    </CollectionView.Footer>
                </CollectionView>
            </RefreshView>
        </Border>

        <!-- 
             |                     |
             |    Status Bar       |
             |                     |
              -->
        <Border Grid.Row="2"
                StrokeThickness="2"
                BackgroundColor="{StaticResource ButtonFace}">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="0" />
            </Border.StrokeShape>
            <Border.Stroke>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="{StaticResource White}" Offset="0.0" />
                    <GradientStop Color="{StaticResource Gray300}" Offset="0.5" />
                    <GradientStop Color="{StaticResource Gray700}" Offset="1.0" />
                </LinearGradientBrush>
            </Border.Stroke>
            
            <Grid Padding="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                
                <!-- 
                     |                     |
                     |   System Buttons    |
                     |                     |
                      -->
                <HorizontalStackLayout Grid.Column="0" Spacing="2">
                    <Button Text="❓"
                            Command="{Binding ShowHelpCommand}"
                            WidthRequest="24"
                            HeightRequest="24"
                            FontFamily="MS Sans Serif"
                            FontSize="12"
                            Padding="2" />
                    <Button Text="⚙️"
                            Command="{Binding OpenSettingsCommand}"
                            WidthRequest="24"
                            HeightRequest="24"
                            FontFamily="MS Sans Serif"
                            FontSize="12"
                            Padding="2" />
                 
                </HorizontalStackLayout>
                
                <!-- 
                     |                     |
                     |   Status Display    |
                     |                     |
                      -->
                <Border Grid.Column="1"
                        StrokeThickness="1"
                        Stroke="{StaticResource Gray500}"
                        BackgroundColor="{StaticResource Gray100}"
                        Margin="4,0"
                        Padding="4,0">
                    <HorizontalStackLayout Spacing="8">
                        <Label Text="{Binding FilteredNotes.Count, StringFormat='{0} document(s)'}"
                               VerticalOptions="Center"
                               FontFamily="MS Sans Serif"
                               FontSize="10" />
                        <Label Text="• Press ❓ for help • ⚙️ for settings • v4.1.0"
                               VerticalOptions="Center"
                               FontFamily="MS Sans Serif"
                               FontSize="9"
                               TextColor="{StaticResource Gray600}" />
                    </HorizontalStackLayout>
                </Border>
                
                <!-- 
                     |                     |
                     |  Action Buttons     |
                     |                     |
                      -->
                <HorizontalStackLayout Grid.Column="2" Spacing="2">
                    <Button Text="New"
                            Command="{Binding AddNoteCommand}"
                            WidthRequest="48"
                            HeightRequest="24"
                            FontFamily="MS Sans Serif"
                            FontSize="10"
                            Padding="2" />
                    
                    <Button Text="Refresh"
                            Command="{Binding RefreshCommand}"
                            WidthRequest="56"
                            HeightRequest="24"
                            FontFamily="MS Sans Serif"
                            FontSize="10"
                            Padding="2" />
                    
                    <Border StrokeThickness="1"
                            Stroke="{StaticResource Gray500}"
                            BackgroundColor="{StaticResource Gray100}"
                            Padding="4,0"
                            Margin="4,0,0,0">
                        <Label Text="{Binding Source={x:Static sys:DateTime.Now}, StringFormat='{0:HH:mm}'}"
                               VerticalOptions="Center"
                               FontFamily="MS Sans Serif"
                               FontSize="10" />
                    </Border>
                </HorizontalStackLayout>
            </Grid>
        </Border>

        <!-- 
             |                     |
             |  Loading Overlay    |
             |                     |
              -->
        <Border Grid.Row="1"
                IsVisible="{Binding IsBusy}"
                StrokeThickness="3"
                Stroke="{StaticResource Gray600}"
                BackgroundColor="{StaticResource ButtonFace}"
                VerticalOptions="Center"
                HorizontalOptions="Center"
                Padding="20">
            <VerticalStackLayout Spacing="8">
                <ActivityIndicator IsRunning="{Binding IsBusy}"
                                 Color="{StaticResource AccentBlue}" />
                <Label Text="Loading..."
                       HorizontalOptions="Center"
                       FontFamily="MS Sans Serif"
                       FontSize="11" />
            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentPage>