<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="NoteApp.Views.NoteDetailPage"
             x:DataType="viewModels:NoteDetailViewModel"
             xmlns:viewModels="clr-namespace:NoteApp.ViewModels"
             Title="{Binding Title}"
             BackgroundColor="{StaticResource WindowsBeige}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                StrokeThickness="2"
                Stroke="{StaticResource ButtonShadow}"
                BackgroundColor="{StaticResource ButtonFace}">
            <Grid Padding="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                
                <HorizontalStackLayout Grid.Column="0" Spacing="8">
                    <Label Text="📝"
                           FontSize="16"
                           VerticalOptions="Center" />
                    <Label Text="Notepad - "
                           FontAttributes="Bold"
                           VerticalOptions="Center"
                           FontFamily="MS Sans Serif"
                           FontSize="12" />
                    <Label Text="{Binding Note.Title, TargetNullValue='[Untitled]'}"
                           VerticalOptions="Center"
                           FontFamily="MS Sans Serif"
                           FontSize="12" />
                </HorizontalStackLayout>
                
                <HorizontalStackLayout Grid.Column="2" Spacing="2">
                    <Button Text="Save"
                            Command="{Binding SaveCommand}"
                            WidthRequest="48"
                            HeightRequest="22"
                            FontFamily="MS Sans Serif"
                            FontSize="10"
                            Padding="2" />
                    <Button Text="Close"
                            Command="{Binding BackCommand}"
                            WidthRequest="48"
                            HeightRequest="22"
                            FontFamily="MS Sans Serif"
                            FontSize="10"
                            Padding="2" />
                </HorizontalStackLayout>
            </Grid>
        </Border>

        <ScrollView Grid.Row="1">
            <Grid Padding="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        StrokeThickness="2"
                        BackgroundColor="{StaticResource Gray100}"
                        Margin="0,0,0,4">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="0" />
                    </Border.StrokeShape>
                    <Border.Stroke>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="{StaticResource Gray700}" Offset="0.0" />
                            <GradientStop Color="{StaticResource Gray300}" Offset="0.5" />
                            <GradientStop Color="{StaticResource White}" Offset="1.0" />
                        </LinearGradientBrush>
                    </Border.Stroke>
                    
                    <Grid Padding="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        
                        <Label Grid.Row="0" Grid.Column="0"
                               Text="Title:"
                               FontAttributes="Bold"
                               VerticalOptions="Center"
                               Margin="0,0,8,0"
                               FontFamily="MS Sans Serif"
                               FontSize="11" />
                        
                        <Border Grid.Row="0" Grid.Column="1"
                                StrokeThickness="2"
                                BackgroundColor="{StaticResource SearchBackground}"
                                Margin="0,0,8,0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="0" />
                            </Border.StrokeShape>
                            <Border.Stroke>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="{StaticResource Gray700}" Offset="0.0" />
                                    <GradientStop Color="{StaticResource Gray300}" Offset="0.5" />
                                    <GradientStop Color="{StaticResource White}" Offset="1.0" />
                                </LinearGradientBrush>
                            </Border.Stroke>
                            <Entry Text="{Binding Note.Title}"
                                   Placeholder="Enter title..."
                                   BackgroundColor="Transparent"
                                   FontFamily="MS Sans Serif"
                                   FontSize="11"
                                   Margin="4,2" />
                        </Border>
                        
                        <Label Grid.Row="0" Grid.Column="2"
                               Text="Category:"
                               FontAttributes="Bold"
                               VerticalOptions="Center"
                               Margin="0,0,8,0"
                               FontFamily="MS Sans Serif"
                               FontSize="11" />
                        
                        <Picker Grid.Row="0" Grid.Column="3"
                                Title="Select"
                                SelectedItem="{Binding Note.Category}"
                                BackgroundColor="{StaticResource CategoryBackground}"
                                FontFamily="MS Sans Serif"
                                FontSize="11">
                            <Picker.ItemsSource>
                                <x:Array Type="{x:Type x:String}">
                                    <x:String>General</x:String>
                                    <x:String>Work</x:String>
                                    <x:String>Personal</x:String>
                                    <x:String>Ideas</x:String>
                                    <x:String>Tasks</x:String>
                                    <x:String>Meeting</x:String>
                                    <x:String>Project</x:String>
                                    <x:String>Research</x:String>
                                </x:Array>
                            </Picker.ItemsSource>
                        </Picker>
                        
                        <Label Grid.Row="1" Grid.Column="0"
                               Text="Tags:"
                               FontAttributes="Bold"
                               VerticalOptions="Center"
                               Margin="0,8,8,0"
                               FontFamily="MS Sans Serif"
                               FontSize="11" />
                        
                        <Border Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3"
                                StrokeThickness="2"
                                BackgroundColor="{StaticResource SearchBackground}"
                                Margin="0,8,0,0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="0" />
                            </Border.StrokeShape>
                            <Border.Stroke>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="{StaticResource Gray700}" Offset="0.0" />
                                    <GradientStop Color="{StaticResource Gray300}" Offset="0.5" />
                                    <GradientStop Color="{StaticResource White}" Offset="1.0" />
                                </LinearGradientBrush>
                            </Border.Stroke>
                            <Entry Text="{Binding Note.Tags}"
                                   Placeholder="comma, separated, tags"
                                   BackgroundColor="Transparent"
                                   FontFamily="MS Sans Serif"
                                   FontSize="11"
                                   Margin="4,2" />
                        </Border>
                    </Grid>
                </Border>

                <Border Grid.Row="1"
                        StrokeThickness="1"
                        Stroke="{StaticResource Gray500}"
                        BackgroundColor="{StaticResource MetadataBackground}"
                        Padding="6"
                        Margin="0,0,0,4">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        
                        <HorizontalStackLayout Grid.Column="0" Spacing="4">
                            <Label Text="Created:"
                                   FontAttributes="Bold"
                                   FontSize="9"
                                   FontFamily="MS Sans Serif" />
                            <Label Text="{Binding Note.FormattedDateCreated}"
                                   FontSize="9"
                                   FontFamily="MS Sans Serif" />
                        </HorizontalStackLayout>
                        
                        <HorizontalStackLayout Grid.Column="1" Spacing="4">
                            <Label Text="Modified:"
                                   FontAttributes="Bold"
                                   FontSize="9"
                                   FontFamily="MS Sans Serif" />
                            <Label Text="{Binding Note.FormattedDateModified}"
                                   FontSize="9"
                                   FontFamily="MS Sans Serif" />
                        </HorizontalStackLayout>
                        
                        <HorizontalStackLayout Grid.Column="2" Spacing="4" HorizontalOptions="End">
                            <Label Text="ID:"
                                   FontAttributes="Bold"
                                   FontSize="9"
                                   FontFamily="MS Sans Serif" />
                            <Label Text="{Binding Note.Id, StringFormat='#{0:D4}'}"
                                   FontSize="9"
                                   FontFamily="MS Sans Serif" />
                        </HorizontalStackLayout>
                    </Grid>
                </Border>

                <Border Grid.Row="2"
                        StrokeThickness="2"
                        BackgroundColor="{StaticResource NoteContentBackground}">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="0" />
                    </Border.StrokeShape>
                    <Border.Stroke>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="{StaticResource Gray700}" Offset="0.0" />
                            <GradientStop Color="{StaticResource Gray300}" Offset="0.5" />
                            <GradientStop Color="{StaticResource White}" Offset="1.0" />
                        </LinearGradientBrush>
                    </Border.Stroke>
                    
                    <Editor Text="{Binding Note.Content}"
                            Placeholder="Start typing..."
                            FontFamily="Courier New"
                            FontSize="11"
                            AutoSize="TextChanges"
                            BackgroundColor="Transparent"
                            MinimumHeightRequest="400"
                            Margin="8"
                            Keyboard="Text" />
                </Border>
            </Grid>
        </ScrollView>

        <Border Grid.Row="2"
                StrokeThickness="2"
                BackgroundColor="{StaticResource ButtonFace}">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="0" />
            </Border.StrokeShape>
            <Border.Stroke>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="{StaticResource White}" Offset="0.0" />
                    <GradientStop Color="{StaticResource Gray300}" Offset="0.5" />
                    <GradientStop Color="{StaticResource Gray700}" Offset="1.0" />
                </LinearGradientBrush>
            </Border.Stroke>
            
            <Grid Padding="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                
                <Border Grid.Column="0"
                        StrokeThickness="1"
                        Stroke="{StaticResource Gray500}"
                        BackgroundColor="{StaticResource Gray100}"
                        Padding="4,0"
                        Margin="0,0,8,0">
                    <Label Text="Press F1 for Help"
                           VerticalOptions="Center"
                           FontFamily="MS Sans Serif"
                           FontSize="10" />
                </Border>
                
                <HorizontalStackLayout Grid.Column="1" Spacing="4">
                    <Button Text="💾 Save"
                            Command="{Binding SaveCommand}"
                            WidthRequest="60"
                            HeightRequest="24"
                            FontFamily="MS Sans Serif"
                            FontSize="10"
                            BackgroundColor="{StaticResource AccentBlue}"
                            TextColor="White"
                            Padding="2" />
                    
                    <Button Text="Cancel"
                            Command="{Binding BackCommand}"
                            WidthRequest="56"
                            HeightRequest="24"
                            FontFamily="MS Sans Serif"
                            FontSize="10"
                            Padding="2" />
                </HorizontalStackLayout>
            </Grid>
        </Border>
    </Grid>
</ContentPage>