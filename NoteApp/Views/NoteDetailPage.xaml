<?xml version="1.0" encoding="utf-8" ?>
<!-- 
  I cant comment this with the comment boxes so enjoy this new comment style
-->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="NoteApp.Views.NoteDetailPage"
             xmlns:viewModels="clr-namespace:NoteApp.ViewModels"
             x:DataType="viewModels:NoteDetailViewModel"
             Title="{Binding Title}"
             BackgroundColor="{StaticResource WindowsBeige}">

    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- Top bar/header -->
            <RowDefinition Height="*" />   <!-- Scrollable content area -->
            <RowDefinition Height="Auto" /> <!-- Bottom action bar/footer -->
        </Grid.RowDefinitions>

        <!-- =================================================================== -->
        <!-- Row 0: Top Bar                                     -->
        <!-- =================================================================== -->
        <Border Grid.Row="0"
                StrokeThickness="2"
                Stroke="{StaticResource ButtonShadow}"
                BackgroundColor="{StaticResource ButtonFace}">
            <Grid Padding="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" /> <!-- Left-aligned content -->
                    <ColumnDefinition Width="*" />    <!-- Spacer -->
                    <ColumnDefinition Width="Auto" /> <!-- Right-aligned content -->
                </Grid.ColumnDefinitions>
                
                <!-- Left side of the top bar -->
                <HorizontalStackLayout Grid.Column="0" Spacing="8">
                    <Label Text="📝" FontSize="16" VerticalOptions="Center" />
                    <Label Text="Quicknote - " FontAttributes="Bold" VerticalOptions="Center" FontFamily="MS Sans Serif" FontSize="12" />
                    <Label Text="{Binding Note.Title, TargetNullValue='[Untitled]'}" VerticalOptions="Center" FontFamily="MS Sans Serif" FontSize="12" />
                    
                    <!-- Unsaved changes indicator -->
                    <Label Text="●" VerticalOptions="Center" FontFamily="MS Sans Serif" FontSize="12" TextColor="Orange"
                           IsVisible="{Binding HasUnsavedChanges}"
                           ToolTipProperties.Text="Unsaved changes - auto-saving..." />
                </HorizontalStackLayout>
                
                <!-- Right side of the top bar -->
                <HorizontalStackLayout Grid.Column="2" Spacing="2">
                    <Button Text="💾 Save" Command="{Binding SaveCommand}" WidthRequest="60" HeightRequest="22" FontFamily="MS Sans Serif" FontSize="10" Padding="2" />
                    <Button Text="❓" Command="{Binding ShowHelpCommand}" WidthRequest="22" HeightRequest="22" FontFamily="MS Sans Serif" FontSize="10" Padding="2" />
                    <Button Text="✕" Command="{Binding BackCommand}" WidthRequest="22" HeightRequest="22" FontFamily="MS Sans Serif" FontSize="10" Padding="2" />
                </HorizontalStackLayout>
            </Grid>
        </Border>

        <!-- =================================================================== -->
        <!-- Row 1: Main Content Area                                            -->
        <!-- =================================================================== -->
        <ScrollView Grid.Row="1">
            <Grid Padding="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" /> 
                    <RowDefinition Height="Auto" /> 
                    <RowDefinition Height="*" />   
                </Grid.RowDefinitions>

                <!-- Metadata section  -->
                <Border Grid.Row="0" StrokeThickness="2" BackgroundColor="{StaticResource Gray100}" Margin="0,0,0,4">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="0" />
                    </Border.StrokeShape>
                    <Border.Stroke>
                        
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="{StaticResource Gray700}" Offset="0.0" />
                            <GradientStop Color="{StaticResource Gray300}" Offset="0.5" />
                            <GradientStop Color="{StaticResource White}" Offset="1.0" />
                        </LinearGradientBrush>
                    </Border.Stroke>
                    
                    <Grid Padding="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" /> <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" /> <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" /> <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        
                        <!-- Note Title Input -->
                        <Label Grid.Row="0" Grid.Column="0" Text="Title:" FontAttributes="Bold" VerticalOptions="Center" Margin="0,0,8,0" FontFamily="MS Sans Serif" FontSize="11" />
                        <Border Grid.Row="0" Grid.Column="1" StrokeThickness="2" BackgroundColor="{StaticResource SearchBackground}" Margin="0,0,8,0">
                           <Border.StrokeShape><RoundRectangle CornerRadius="0" /></Border.StrokeShape>
                            <Border.Stroke>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="{StaticResource Gray700}" Offset="0.0" /> <GradientStop Color="{StaticResource Gray300}" Offset="0.5" /> <GradientStop Color="{StaticResource White}" Offset="1.0" />
                                </LinearGradientBrush>
                            </Border.Stroke>
                            <Entry Text="{Binding Note.Title}" Placeholder="Auto-generated if empty..." BackgroundColor="Transparent" FontFamily="MS Sans Serif" FontSize="11" Margin="4,2" />
                        </Border>
                        
                        <!-- Note Category  -->
                        <Label Grid.Row="0" Grid.Column="2" Text="Category:" FontAttributes="Bold" VerticalOptions="Center" Margin="0,0,8,0" FontFamily="MS Sans Serif" FontSize="11" />
                        <Picker Grid.Row="0" Grid.Column="3" Title="Select" SelectedItem="{Binding Note.Category}" BackgroundColor="{StaticResource CategoryBackground}" FontFamily="MS Sans Serif" FontSize="11">
                            <Picker.ItemsSource>
                                <x:Array Type="{x:Type x:String}">
                                    <x:String>General</x:String> <x:String>Work</x:String> <x:String>Personal</x:String> <x:String>Ideas</x:String> <x:String>Tasks</x:String>
                                    <x:String>Meeting</x:String> <x:String>Project</x:String> <x:String>Research</x:String> <x:String>Important</x:String> <x:String>Archive</x:String>
                                </x:Array>
                            </Picker.ItemsSource>
                        </Picker>
                        
                        <!-- Note Tags  -->
                        <Label Grid.Row="1" Grid.Column="0" Text="Tags:" FontAttributes="Bold" VerticalOptions="Center" Margin="0,8,8,0" FontFamily="MS Sans Serif" FontSize="11" />
                        <Border Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" StrokeThickness="2" BackgroundColor="{StaticResource SearchBackground}" Margin="0,8,0,0">
                            <Border.StrokeShape><RoundRectangle CornerRadius="0" /></Border.StrokeShape>
                             <Border.Stroke>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="{StaticResource Gray700}" Offset="0.0" /> <GradientStop Color="{StaticResource Gray300}" Offset="0.5" /> <GradientStop Color="{StaticResource White}" Offset="1.0" />
                                </LinearGradientBrush>
                            </Border.Stroke>
                            <Entry Text="{Binding Note.Tags}" Placeholder="comma, separated, tags, for, organisation" BackgroundColor="Transparent" FontFamily="MS Sans Serif" FontSize="11" Margin="4,2" />
                        </Border>
                    </Grid>
                </Border>

                
                <Border Grid.Row="1" StrokeThickness="1" Stroke="{StaticResource Gray500}" BackgroundColor="{StaticResource MetadataBackground}" Padding="6" Margin="0,0,0,4">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" /> <ColumnDefinition Width="*" /> <ColumnDefinition Width="*" /> <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        
                        <HorizontalStackLayout Grid.Column="0" Spacing="4">
                            <Label Text="Created:" FontAttributes="Bold" FontSize="9" FontFamily="MS Sans Serif" />
                            <Label Text="{Binding Note.FormattedDateCreated}" FontSize="9" FontFamily="MS Sans Serif" />
                        </HorizontalStackLayout>
                        
                        <HorizontalStackLayout Grid.Column="1" Spacing="4">
                            <Label Text="Modified:" FontAttributes="Bold" FontSize="9" FontFamily="MS Sans Serif" />
                            <Label Text="{Binding Note.FormattedDateModified}" FontSize="9" FontFamily="MS Sans Serif" />
                        </HorizontalStackLayout>
                        
                        <HorizontalStackLayout Grid.Column="2" Spacing="4">
                            <Label Text="Auto-save:" FontAttributes="Bold" FontSize="9" FontFamily="MS Sans Serif" />
                            <Label Text="ON" FontSize="9" FontFamily="MS Sans Serif" TextColor="Green" />
                        </HorizontalStackLayout>
                        
                        <HorizontalStackLayout Grid.Column="3" Spacing="4">
                            <Label Text="ID:" FontAttributes="Bold" FontSize="9" FontFamily="MS Sans Serif" />
                            <Label Text="{Binding Note.Id, StringFormat='#{0:D4}'}" FontSize="9" FontFamily="MS Sans Serif" />
                        </HorizontalStackLayout>
                    </Grid>
                </Border>

                <!-- The main text editor for the note -->
                <Border Grid.Row="2" StrokeThickness="2" BackgroundColor="{StaticResource NoteContentBackground}">
                    <Border.StrokeShape><RoundRectangle CornerRadius="0" /></Border.StrokeShape>
                    <Border.Stroke>
                         <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="{StaticResource Gray700}" Offset="0.0" /> <GradientStop Color="{StaticResource Gray300}" Offset="0.5" /> <GradientStop Color="{StaticResource White}" Offset="1.0" />
                        </LinearGradientBrush>
                    </Border.Stroke>
                    
                    <Editor Text="{Binding Note.Content}"
                            Placeholder="Start typing your note here... (auto-saves as you type)"
                            FontFamily="Courier New"
                            FontSize="12"
                            AutoSize="TextChanges"
                            BackgroundColor="Transparent"
                            MinimumHeightRequest="400"
                            Margin="8"
                            Keyboard="Text" />
                </Border>
            </Grid>
        </ScrollView>

        <!-- =================================================================== -->
        <!-- Row 2: Footer                                  -->
        <!-- =================================================================== -->
        <Border Grid.Row="2" StrokeThickness="2" BackgroundColor="{StaticResource ButtonFace}">
            <Border.StrokeShape><RoundRectangle CornerRadius="0" /></Border.StrokeShape>
            <Border.Stroke>
                
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="{StaticResource White}" Offset="0.0" />
                    <GradientStop Color="{StaticResource Gray300}" Offset="0.5" />
                    <GradientStop Color="{StaticResource Gray700}" Offset="1.0" />
                </LinearGradientBrush>
            </Border.Stroke>
            
            <Grid Padding="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />    <!-- Left-aligned status info -->
                    <ColumnDefinition Width="Auto" /> <!-- Right-aligned action buttons -->
                </Grid.ColumnDefinitions>
                
                <!-- Status bar with help info -->
                <Border Grid.Column="0" StrokeThickness="1" Stroke="{StaticResource Gray500}" BackgroundColor="{StaticResource Gray100}" Padding="4,0" Margin="0,0,8,0">
                    <HorizontalStackLayout Spacing="8">
                        <Button Text="❓" Command="{Binding ShowHelpCommand}" WidthRequest="24" HeightRequest="20" FontFamily="MS Sans Serif" FontSize="10" Padding="0" />
                        <Label Text="Auto-save: 3sec delay, then configurable interval • Press ❓ for help" VerticalOptions="Center" FontFamily="MS Sans Serif" FontSize="10" />
                    </HorizontalStackLayout>
                </Border>
                
                <!-- Main action buttons -->
                <HorizontalStackLayout Grid.Column="1" Spacing="4">
                    <Button Text="💾 Save Now" Command="{Binding SaveCommand}" WidthRequest="80" HeightRequest="24" FontFamily="MS Sans Serif" FontSize="10" BackgroundColor="{StaticResource AccentBlue}" TextColor="White" Padding="2" />
                    
                    <!-- Delete button -->
                    <Button Text="🗑 Delete" Command="{Binding DeleteCommand}" WidthRequest="56" HeightRequest="24" FontFamily="MS Sans Serif" FontSize="10" BackgroundColor="{StaticResource ClassicRed}" TextColor="White" Padding="2"
                            IsVisible="{Binding CanDelete}" />
                    
                    <Button Text="← Back" Command="{Binding BackCommand}" WidthRequest="56" HeightRequest="24" FontFamily="MS Sans Serif" FontSize="10" Padding="2" />
                </HorizontalStackLayout>
            </Grid>
        </Border>
    </Grid>
</ContentPage>
